{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "esha:portrait-drawing",
  "visibility": "private",
  "url": "",
  "description": "A Viam module for drawing an image with an arm: converts an image into poses, moves an arm through them, and shows them in the visualizer.",
  "models": [
    {
      "api": "rdk:component:camera",
      "model": "esha:portrait-drawing:image-to-poses"
    },
    {
      "api": "rdk:component:camera",
      "model": "esha:portrait-drawing:background-removal"
    },
    {
      "api": "rdk:service:generic",
      "model": "esha:portrait-drawing:poses-to-arm"
    },
    {
      "api": "rdk:service:world_state_store",
      "model": "esha:portrait-drawing:poses-to-3d-scene"
    },
    {
      "api": "rdk:service:generic",
      "model": "esha:portrait-drawing:table-surface"
    }
  ],
  "entrypoint": "bin/portrait-drawing",
  "build": {
    "build": "make module.tar.gz",
    "path": "module.tar.gz",
    "arch": ["linux/amd64", "linux/arm64", "darwin/arm64"]
  }
}
